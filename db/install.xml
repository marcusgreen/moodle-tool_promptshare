<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="admin/tool/promptshare/db" VERSION="20230826" COMMENT="XMLDB file for Moodle admin/tool/promptshare"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="tool_promptshare" COMMENT="Stored prompts for AI tools with user and global sharing">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="User who created the prompt"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Name of the prompt"/>
        <FIELD NAME="template" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="The prompt template with placeholders"/>
        <FIELD NAME="is_global" TYPE="int" LENGTH="1" NOTNULL="true" SEQUENCE="false" COMMENT="Whether this prompt is shared globally"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time when the prompt was created"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time when the prompt was last modified"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="is_global" UNIQUE="false" FIELDS="is_global"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>

